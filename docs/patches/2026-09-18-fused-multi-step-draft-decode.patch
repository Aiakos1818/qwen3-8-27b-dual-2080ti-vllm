+    def update_draft_decode_metadata(self, metadata: FlashInferMetadata) -> None:
+        """Refresh paged-KV metadata for the next fused draft step.
+
+        Sequence lengths advance on the device (``_update_draft_inputs_kernel``)
+        while the draft loop reuses one metadata build, so the paged-KV indptr,
+        last-page lengths and page indices are recomputed from the device state
+        with capture-safe kernels.
+        """
+        decode = metadata.decode
+        if (
+            not self._native_spec_as_decode
+            or not isinstance(decode, FIDecode)
+            or decode.q_len_per_req != 1
+            or decode.seq_lens is None
+            or decode.block_table is None
+        ):
+            return
+
+        num_reqs = decode.seq_lens.shape[0]
+        paged_kv_indptr = self.paged_kv_indptr.gpu[: num_reqs + 1]
+        _paged_kv_meta_kernel[(1,)](
+            decode.seq_lens,
+            paged_kv_indptr,
+            self.paged_kv_last_page_len.gpu[:num_reqs],
+            self.page_size,
+            num_reqs,
+            BLOCK_SIZE=max(triton.next_power_of_2(num_reqs), 16),
+        )
+        _copy_page_indices_kernel[(num_reqs,)](
+            self.paged_kv_indices,
+            decode.block_table,
+            decode.block_table.stride(0),
+            paged_kv_indptr,
+            BLOCK_SIZE=1024,
+        )
+
 
