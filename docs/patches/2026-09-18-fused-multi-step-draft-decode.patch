+@triton.jit
+def _paged_kv_meta_kernel(
+    seq_lens,
+    paged_kv_indptr,
+    paged_kv_last_page_len,
+    page_size,
+    num_reqs,
+    BLOCK_SIZE: tl.constexpr,
+):
+    """Recompute paged-KV metadata from sequence lengths on the device.
+
+    Mirrors ``_compute_flashinfer_kv_metadata`` (ceil division for the block
+    count, page_size for a full last page) so the fused draft loop can refresh
+    the metadata between steps without a host round trip.
+    """
+    offs = tl.arange(0, BLOCK_SIZE)
+    mask = offs < num_reqs
+    seq = tl.load(seq_lens + offs, mask=mask, other=0).to(tl.int32)
+    num_blocks = (seq + page_size - 1) // page_size
+    last_page_len = seq % page_size
+    last_page_len = tl.where(
+        (last_page_len == 0) & (seq != 0), page_size, last_page_len
+    )
+    tl.store(paged_kv_indptr + 1 + offs, tl.cumsum(num_blocks, axis=0), mask=mask)
+    tl.store(paged_kv_last_page_len + offs, last_page_len, mask=mask)
+
