[Unit]
Description=Qwen3.8-27B AWQ-INT4 435K SSD-offload vLLM on dual RTX 2080 Ti NVLink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
Group=YOUR_LINUX_USER
WorkingDirectory=/opt/qwen3-8-27b-dual-2080ti-vllm
EnvironmentFile=/etc/qwen3.8-vllm-435k.env
ExecStart=/opt/qwen3-8-27b-dual-2080ti-vllm/scripts/run_vllm_qwen38_awq_fp8e4m3_435k_ssd.sh
Restart=always
RestartSec=10
TimeoutStartSec=900
StandardOutput=append:/var/log/qwen3.8-vllm-435k.log
StandardError=append:/var/log/qwen3.8-vllm-435k.log

[Install]
WantedBy=multi-user.target
