# Copy to .env for scripts/run_vllm_qwen38_awq_fp8e4m3_500k_RAMx2.sh
# (or to /etc/qwen3.8-vllm-500k-RAMx2.env for systemd).
#
# This profile targets the upstream-based branch (sm75-upstream) and uses only
# upstream knobs.
MODEL_PATH=/opt/models/Qwen3.8-27B-AWQ-INT4-yarn512k
SERVED_MODEL_NAME=qwen38-27b
HOST=0.0.0.0
PORT=8000
VLLM_PYTHON=/opt/venvs/vllm-0271/bin/python
FLASHQLA_PATH=/opt/src/FlashQLA-SM70-SM75
CUDA_HOME=/usr/local/cuda
OMP_NUM_THREADS=8
VLLM_USE_DEEP_GEMM=0
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_QWOPUS_MTP_BF16_DRAFT=1
VLLM_SM75_SPEC_SYNC_MODE=safe
# Verify spec drafts on the native FlashInfer decode path (keeps full
# cudagraphs under MTP on SM75). Set to 0 to disable.
VLLM_FLASHINFER_NATIVE_SPEC_AS_DECODE=1
VLLM_USE_V2_MODEL_RUNNER=1

# --- KV profile ------------------------------------------------------------
MAX_MODEL_LEN=500800
KV_CACHE_MEMORY_BYTES=9600000000
GPU_MEMORY_UTILIZATION=0.92
SPEC_NUM_TOKENS=3

# --- RAM-only offload sized for two full-length contexts -------------------
# The CPU tier is both the store and the promotion staging, and it keeps whole
# chains: 2 x ceil(500800 / 1600) = 626 chunks at ~55.8 MB each = 34.9 GB, so two
# long sessions can be resident and either one restored. A third session evicts
# the least recently restored one, and nothing is kept anywhere else.
# 34.9 GB is a pre-faulted /dev/shm reservation; the default tmpfs is half of RAM
# (32 GiB on a 64 GB host), so remount it to ~36 GiB:
#   mount -o remount,size=36864M /dev/shm
CPU_BYTES_TO_USE=34930800000
KV_ENGINE_ID=qwen38-27b-500k-RAMx2
