# Copy to .env for scripts/run_vllm_qwen38_awq_fp8e4m3_435k_ssd.sh
# (or to /etc/qwen3.8-vllm-435k.env for systemd).
MODEL_PATH=/opt/models/Qwen3.8-27B-AWQ-INT4-yarn512k
SERVED_MODEL_NAME=qwen38-27b
HOST=0.0.0.0
PORT=8000
VLLM_PYTHON=/opt/venvs/vllm-0271-kv/bin/python
FLASHQLA_PATH=/opt/src/FlashQLA-SM70-SM75
CUDA_HOME=/usr/local/cuda
OMP_NUM_THREADS=8
VLLM_USE_DEEP_GEMM=0
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_QWOPUS_MTP_BF16_DRAFT=1
VLLM_SM75_SPEC_SYNC_MODE=safe
VLLM_USE_V2_MODEL_RUNNER=1

# --- KV optimization -------------------------------------------------------
MAX_MODEL_LEN=435200
KV_CACHE_MEMORY_BYTES=9000000000
GPU_MEMORY_UTILIZATION=0.92
CPU_BYTES_TO_USE=4000000000
SPEC_NUM_TOKENS=3
VLLM_PIN_MIN_TOKENS=16000
VLLM_MAMBA_CKPT_TOKENS=32000
VLLM_MAMBA_CKPT_ANCHORS=3
VLLM_HOSTTIER_EVICT_SMALL_TOKENS=32000

# --- SSD tier (required for this profile) ----------------------------------
VLLM_SSD_ROOT=/var/lib/qwen3.8-vllm/ssd_kv
VLLM_SSD_QUOTA_BYTES=68719476736
VLLM_SSD_MAX_MBPS=800
VLLM_SSD_CLEAN_START=1
VLLM_SSD_ONLY=1
