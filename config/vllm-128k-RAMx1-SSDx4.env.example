# Copy to .env for scripts/run_vllm_qwen38_awq_fp8e4m3_128k_RAMx1_SSDx4.sh
# (or to /etc/qwen3.8-vllm-128k-RAMx1-SSDx4.env for systemd).
#
# This profile targets the upstream-based branch (2080ti_dual_qwen38-27B) and uses only
# upstream knobs.
MODEL_PATH=/opt/models/Qwen3.8-27B-AWQ-INT4-yarn512k
SERVED_MODEL_NAME=qwen38-27b
HOST=0.0.0.0
PORT=8000
VLLM_PYTHON=/opt/venvs/vllm-0271/bin/python
FLASHQLA_PATH=/opt/src/FlashQLA-SM70-SM75
CUDA_HOME=/usr/local/cuda
OMP_NUM_THREADS=8
VLLM_USE_DEEP_GEMM=0
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_QWOPUS_MTP_BF16_DRAFT=1
VLLM_SM75_SPEC_SYNC_MODE=safe
# Verify spec drafts on the native FlashInfer decode path (keeps full
# cudagraphs under MTP on SM75). Set to 0 to disable.
VLLM_FLASHINFER_NATIVE_SPEC_AS_DECODE=1
VLLM_USE_V2_MODEL_RUNNER=1

# --- KV profile ------------------------------------------------------------
MAX_MODEL_LEN=131072
KV_CACHE_MEMORY_BYTES=3000000000
GPU_MEMORY_UTILIZATION=0.92
# 5 beats 3 on decode throughput at every context measured
# (31.5K +21%, 128K +23%, 250K +37%); n>=7 fails to start.
SPEC_NUM_TOKENS=5

# --- tiered offload (CPU primary + disk secondary) -------------------------
# The /dev/shm staging file is CPU_BYTES_TO_USE large; on a host with
# RLIMIT_MEMLOCK below it, cudaHostRegister fails and transfers fall back to
# unpinned DMA (requires the sticky-error fix).
# A promoted chain is retained in the CPU tier, so it must hold a whole chain:
# ~55.8 MB per 1600-token chunk. 128K -> 82 chunks -> 4.58e9 = one full context,
# which is all the promotion staging needs (contexts also live on disk).
# Undersizing this makes evicted full-length sessions restore nothing.
CPU_BYTES_TO_USE=4575600000
VLLM_SSD_ROOT=/var/lib/qwen3.8-vllm/ssd_kv
# Byte budget of the disk tier; past it the least recently restored blocks are
# evicted, so the directory cannot fill the filesystem (0 = unbounded).
# Four full-length contexts (4 x 4.58 GB = 18.3 GB): the newest four sessions
# stay restorable while older ones age out of the LRU ring.
VLLM_SSD_MAX_BYTES=18302400000
# Keep the directory across restarts (the budget reclaims); set 1 to wipe it.
VLLM_SSD_CLEAN_START=0
KV_ENGINE_ID=qwen38-27b-128k-RAMx1-SSDx4
