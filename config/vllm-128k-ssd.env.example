# Copy to .env for scripts/run_vllm_qwen38_awq_fp8e4m3_128k_ssd.sh
# (or to /etc/qwen3.8-vllm-128k-ssd.env for systemd).
#
# This profile targets the upstream-based branch (sm75-upstream) and uses only
# upstream knobs.
MODEL_PATH=/opt/models/Qwen3.8-27B-AWQ-INT4-yarn512k
SERVED_MODEL_NAME=qwen38-27b
HOST=0.0.0.0
PORT=8000
VLLM_PYTHON=/opt/venvs/vllm-0271/bin/python
FLASHQLA_PATH=/opt/src/FlashQLA-SM70-SM75
CUDA_HOME=/usr/local/cuda
OMP_NUM_THREADS=8
VLLM_USE_DEEP_GEMM=0
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_QWOPUS_MTP_BF16_DRAFT=1
VLLM_SM75_SPEC_SYNC_MODE=safe
VLLM_USE_V2_MODEL_RUNNER=1

# --- KV profile ------------------------------------------------------------
MAX_MODEL_LEN=131072
KV_CACHE_MEMORY_BYTES=3000000000
GPU_MEMORY_UTILIZATION=0.92
SPEC_NUM_TOKENS=3

# --- tiered offload (CPU primary + disk secondary) -------------------------
# The /dev/shm staging file is CPU_BYTES_TO_USE large; on a host with
# RLIMIT_MEMLOCK below it, cudaHostRegister fails and transfers fall back to
# unpinned DMA (requires the sticky-error fix).
# A promoted chain is retained in the CPU tier, so it must hold a whole chain:
# ~55.8 MB per 1600-token chunk. 128K -> 82 chunks -> 4.58e9. Undersizing this
# makes evicted full-length sessions restore nothing.
CPU_BYTES_TO_USE=4600000000
VLLM_SSD_ROOT=/var/lib/qwen3.8-vllm/ssd_kv
VLLM_SSD_CLEAN_START=1
KV_ENGINE_ID=qwen38-27b-128k-ssd
