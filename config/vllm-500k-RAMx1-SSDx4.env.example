# Copy to .env for scripts/run_vllm_qwen38_awq_fp8e4m3_500k_RAMx1_SSDx4.sh
# (or to /etc/qwen3.8-vllm-500k-RAMx1-SSDx4.env for systemd).
#
# This profile targets the upstream-based branch (2080ti_dual_qwen38-27B) and uses only
# upstream knobs.
MODEL_PATH=/opt/models/Qwen3.8-27B-AWQ-INT4-yarn512k
SERVED_MODEL_NAME=qwen38-27b
HOST=0.0.0.0
PORT=8000
VLLM_PYTHON=/opt/venvs/vllm-0271/bin/python
FLASHQLA_PATH=/opt/src/FlashQLA-SM70-SM75
CUDA_HOME=/usr/local/cuda
OMP_NUM_THREADS=8
VLLM_USE_DEEP_GEMM=0
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_QWOPUS_MTP_BF16_DRAFT=1
VLLM_SM75_SPEC_SYNC_MODE=safe
# Verify spec drafts on the native FlashInfer decode path (keeps full
# cudagraphs under MTP on SM75). Set to 0 to disable.
VLLM_FLASHINFER_NATIVE_SPEC_AS_DECODE=1
VLLM_USE_V2_MODEL_RUNNER=1

# --- KV profile ------------------------------------------------------------
MAX_MODEL_LEN=500800
KV_CACHE_MEMORY_BYTES=9600000000
GPU_MEMORY_UTILIZATION=0.92
# 6 beats 5 at every context measured (31.5K +4.8%, 215K +13% with
# fp16 KV, 250K +4.7%, 449K +5.4%).
SPEC_NUM_TOKENS=6

# --- tiered offload: RAM x1 (staging) + SSD x4 (store) ---------------------
# CPU: exactly one full-length context = ceil(500800 / 1600) = 313 chunks at
# ~55.8 MB = 17.5 GB. It only has to hold the chain being promoted, so no
# headroom is needed; every stored context also lives on disk. It is a
# pre-faulted /dev/shm reservation (fits the default 32 GiB tmpfs on a 64 GB
# host). A host with RLIMIT_MEMLOCK below it falls back to unpinned DMA and
# needs the sticky-error fix (commit bf78fc276).
CPU_BYTES_TO_USE=17465400000
# Disk: four full-length contexts (4 x 17.5 GB = 69.9 GB), LRU ring: past the
# budget the least recently restored blocks are evicted, so the newest four
# contexts stay restorable and the directory cannot fill the partition.
VLLM_SSD_ROOT=/var/lib/qwen3.8-vllm/ssd_kv
VLLM_SSD_MAX_BYTES=69861600000
# Keep the directory across restarts (the budget reclaims); set 1 to wipe it.
VLLM_SSD_CLEAN_START=0
KV_ENGINE_ID=qwen38-27b-500k-RAMx1-SSDx4
