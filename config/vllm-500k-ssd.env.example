# Copy to .env for scripts/run_vllm_qwen38_awq_fp8e4m3_500k_ssd.sh
# (or to /etc/qwen3.8-vllm-500k-ssd.env for systemd).
#
# This profile targets the upstream-based branch (sm75-upstream) and uses only
# upstream knobs.
MODEL_PATH=/opt/models/Qwen3.8-27B-AWQ-INT4-yarn512k
SERVED_MODEL_NAME=qwen38-27b
HOST=0.0.0.0
PORT=8000
VLLM_PYTHON=/opt/venvs/vllm-0271/bin/python
FLASHQLA_PATH=/opt/src/FlashQLA-SM70-SM75
CUDA_HOME=/usr/local/cuda
OMP_NUM_THREADS=8
VLLM_USE_DEEP_GEMM=0
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_QWOPUS_MTP_BF16_DRAFT=1
VLLM_SM75_SPEC_SYNC_MODE=safe
VLLM_USE_V2_MODEL_RUNNER=1

# --- KV profile ------------------------------------------------------------
MAX_MODEL_LEN=500800
KV_CACHE_MEMORY_BYTES=9600000000
GPU_MEMORY_UTILIZATION=0.92
SPEC_NUM_TOKENS=3

# --- tiered offload (CPU primary + disk secondary) -------------------------
# The /dev/shm staging file is CPU_BYTES_TO_USE large and is pre-faulted before
# the engine starts, so it is a hard RAM reservation: size it for one whole
# chain — ceil(MAX_MODEL_LEN / 1600) chunks at ~55.8 MB each (500.8K -> 313
# chunks -> 17.5 GB) plus ~10% headroom for the tier's own LRU. Undersizing it
# makes evicted full-length sessions restore nothing (0 hits, wasted I/O).
# The default tmpfs is 50% of RAM, so a 64 GB host is the practical minimum;
# on a host with RLIMIT_MEMLOCK below it, cudaHostRegister fails and transfers
# fall back to unpinned DMA (requires the sticky-error fix, commit bf78fc276).
CPU_BYTES_TO_USE=19200000000
VLLM_SSD_ROOT=/var/lib/qwen3.8-vllm/ssd_kv
# Byte budget of the disk tier; past it the least recently restored blocks are
# evicted, so the directory cannot fill the filesystem (0 = unbounded).
# 52.5 GB ~ three full-length 500.8K chains (3 x 17.5 GB).
VLLM_SSD_MAX_BYTES=52500000000
# Keep the directory across restarts (the budget reclaims); set 1 to wipe it.
VLLM_SSD_CLEAN_START=0
KV_ENGINE_ID=qwen38-27b-500k-ssd
